/* Miasma Steam (Adwaita skin).
 * Install: see README — load via Steam -> Settings -> Customize.
 */

:root {
    /* accent */
    --adw-accent-bg-rgb: {{dec:accent}} !important;
    --adw-accent-fg-rgb: {{dec:highlight_fg}} !important;
    --adw-accent-rgb: {{dec:accent}} !important;

    /* destructive buttons */
    --adw-destructive-bg-rgb: {{dec:red}} !important;
    --adw-destructive-fg-rgb: {{dec:fg}} !important;
    --adw-destructive-rgb: {{dec:red}} !important;

    /* levelbars, entries, infobars */
    --adw-success-bg-rgb: {{dec:green}} !important;
    --adw-success-fg-rgb: {{dec:highlight_fg}} !important;
    --adw-success-rgb: {{dec:green}} !important;

    --adw-warning-bg-rgb: {{dec:yellow}} !important;
    --adw-warning-fg-rgb: {{dec:highlight_fg}} !important;
    --adw-warning-fg-a: 0.8 !important;
    --adw-warning-rgb: {{dec:yellow}} !important;

    --adw-error-bg-rgb: {{dec:red}} !important;
    --adw-error-fg-rgb: {{dec:highlight_fg}} !important;
    --adw-error-rgb: {{dec:red}} !important;

    /* window */
    --adw-window-bg-rgb: {{dec:bg}} !important;
    --adw-window-fg-rgb: {{dec:fg}} !important;

    /* views */
    --adw-view-bg-rgb: {{dec:bg}} !important;
    --adw-view-fg-rgb: {{dec:fg}} !important;

    /* header bar, search bar, tab bar */
    --adw-headerbar-bg-rgb: {{dec:bg}} !important;
    --adw-headerbar-fg-rgb: {{dec:fg}} !important;
    --adw-headerbar-border-rgb: {{dec:bright_black}} !important;
    --adw-headerbar-backdrop-rgb: {{dec:bg}} !important;
    --adw-headerbar-shade-rgb: {{dec:bg}} !important;
    --adw-headerbar-shade-a: 0.36 !important;
    --adw-headerbar-darker-shade-rgb: {{dec:bg}} !important;
    --adw-headerbar-darker-shade-a: 0.9 !important;

    /* split pane views */
    --adw-sidebar-bg-rgb: {{dec:bg}} !important;
    --adw-sidebar-fg-rgb: {{dec:fg}} !important;
    --adw-sidebar-backdrop-rgb: {{dec:bright_black}} !important;
    --adw-sidebar-shade-rgb: {{dec:bg}} !important;
    --adw-sidebar-shade-a: 0.36 !important;
    --adw-secondary-sidebar-bg-rgb: {{dec:bg}} !important;
    --adw-secondary-sidebar-fg-rgb: {{dec:fg}} !important;
    --adw-secondary-sidebar-backdrop-rgb: {{dec:bright_black}} !important;
    --adw-secondary-sidebar-shade-rgb: {{dec:bg}} !important;
    --adw-secondary-sidebar-shade-a: 0.36 !important;

    /* cards, boxed lists */
    --adw-card-bg-rgb: 255, 255, 255 !important;
    --adw-card-bg-a: 0.08 !important;
    --adw-card-fg-rgb: 255, 255, 255 !important;
    --adw-card-shade-rgb: 0, 0, 0 !important;
    --adw-card-shade-a: 0.36 !important;

    /* dialogs */
    --adw-dialog-bg-rgb: {{dec:bg}} !important;
    --adw-dialog-fg-rgb: {{dec:fg}} !important;

    /* popovers */
    --adw-popover-bg-rgb: {{dec:bg}} !important;
    --adw-popover-fg-rgb: {{dec:fg}} !important;
    --adw-popover-shade-rgb: {{dec:bg}} !important;
    --adw-popover-shade-a: 0.36 !important;

    /* thumbnails */
    --adw-thumbnail-bg-rgb: {{dec:bg}} !important;

    /* misc */
    --adw-shade-rgb: {{dec:bg}} !important;
    --adw-shade-a: 0.36 !important;
}