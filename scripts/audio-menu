#!/usr/bin/env bash
# Miasma audio menu (wpctl, no extra deps).
vol=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null)
action=$(
  printf '%s\n' \
    "  Vol+ 5%  ($vol)" \
    '  Vol- 5%' \
    '󰝟  Mute toggle' \
    '  Mic mute toggle' |
    wofi --dmenu --prompt 'Audio' --width 340 --height 250 --location center
)
[ -z "$action" ] && exit 0

case "$action" in
  *Vol+*) wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ ;;
  *Vol-*) wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- ;;
  *Mute*) wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
  *Mic*) wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle ;;
esac
